; Engine configuration file.
config_version=5

[application]
config/name="longtuong"
config/description="Tam Quoc side-view RPG - Phase 0 scaffold"
run/main_scene="res://features/main/scenes/MainScene.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[autoload]
GameManager="*res://core/autoload/GameManager.cs"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="longtuong"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
