+        Check(gm.Save.Silver == silverBefore + StageRewardService.SilverPerWin, "battle win grants silver (2.39: was gold)");
         Check(gm.Save.Heroes["custom_hero"].Exp > expBefore || gm.Save.Heroes["custom_hero"].Level > 1,
